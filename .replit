modules = ["web", "bash", "php-8.4", "nodejs-22"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[userenv]

[userenv.development]
APP_DEBUG = "true"
APP_ENV = "local"
DB_CONNECTION = "sqlite"
MAIL_MAILER = "log"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run build && php artisan serve --host=0.0.0.0 --port=5000 --no-reload"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80
